{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc", "$esbuild"]
    },
    {
      "type": "npm",
      "script": "pretest",
      "problemMatcher": ["$tsc", "$esbuild"]
    },
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": "$esbuild-watch"
    }
  ]
}
